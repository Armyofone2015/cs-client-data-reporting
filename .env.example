# --- Database (required for users, passwords, activity) ---
# Vercel/Neon/Supabase Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# --- Auth.js ---
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Portal admins (invite management UI) ---
# Comma-separated emails allowed into /admin
PORTAL_ADMIN_EMAILS=you@company.com
# Shared password for those admin emails
PORTAL_ADMIN_PASSWORD=

# --- Positive Intelligence admin panel (engagement data source) ---
# Same credentials used by the client metrics dashboard
ADMIN_EMAIL=
ADMIN_PASS=
